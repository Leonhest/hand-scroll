{
  "manifest_version": 3,
  "name": "Hand Scroll",
  "version": "1.0.0",
  "description": "Scroll web pages with a webcam hand gesture: pinch your fingers to grab the page, then move your hand up or down.",
  "homepage_url": "https://github.com/Leonhest/hand-scroll",
  "action": {
    "default_title": "Hand Scroll: off (click to turn on)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage",
    "offscreen",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
